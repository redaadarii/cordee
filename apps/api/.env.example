DATABASE_URL=postgresql://cordee:cordee@localhost:5432/cordee
PORT=3000
WEB_ORIGIN=http://localhost:5173
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# E-mails (invitations, mot de passe oublié). Sans SMTP_URL, ils s'affichent dans la console de l'API.
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.com:587
MAIL_FROM=Cordée <no-reply@cordee.local>

# Pièces jointes
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
