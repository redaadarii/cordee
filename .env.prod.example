# Adresse publique de l'application (utilisée dans les liens des e-mails).
PUBLIC_URL=https://cordee.exemple.ma
WEB_PORT=8080

# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=

# Sans SMTP_URL, les e-mails (invitations, mot de passe oublié) restent dans les journaux de l'API.
SMTP_URL=
MAIL_FROM=Cordée <no-reply@cordee.exemple.ma>
MAX_UPLOAD_MB=10
